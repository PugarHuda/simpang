# Model provider (one is required). There is no mock mode: with no key, /api/run answers 503.
VENICE_API_KEY=
# OPENROUTER_API_KEY= / AI_GATEWAY_API_KEY= / ANTHROPIC_API_KEY=

# Models (Venice defaults): scan openai-gpt-56-luna, main claude-sonnet-5, prefetch+classifier gpt-4o-mini.
# For cheap test runs: SIMPANG_MAIN_MODEL=qwen3-coder-480b-a35b-instruct-turbo
# SIMPANG_SCAN_MODEL=
# SIMPANG_MAIN_MODEL=
# SIMPANG_PREFETCH_MODEL=

# The repo the agent works on (defaults to examples/acme). Its writes land in .simpang/runs/<id>/.
# SIMPANG_REPO_DIR=

# x402 (seller side, official @x402/next SDK). Defaults: Base Sepolia, testnet USDC, x402.org facilitator.
# Payments are always real: the EIP-3009 signature is verified and USDC moves to X402_PAY_TO.
X402_PAY_TO=0x0000000000000000000000000000000000000001
X402_PRICE=$0.01
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# Base mainnet: X402_NETWORK=eip155:8453 + X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402

# The agent's wallet for the paidFetch tool (the x402 BUYER side): a private key holding Base Sepolia USDC.
# Without it the paidFetch tool is not registered. In tests, X402_TEST_BUYER_KEY=<the same key> makes unlock settle on-chain.
# X402_BUYER_PRIVATE_KEY=

# Rate limits on the endpoints that cost money (/api/run, /api/fork): per IP per hour, and total per day.
# SIMPANG_RUN_LIMIT=8
# SIMPANG_DAILY_LIMIT=150

# How many divergences are free before the x402 gate (default 3; the tests use 2).
# SIMPANG_FREE_BRANCHES=3
